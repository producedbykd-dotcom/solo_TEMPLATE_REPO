# Release Engine — Solo Edition
# Copy to .env and fill in. `npm run setup` does this for you.

# ── Required ────────────────────────────────────────────────────────────────

# Supabase → Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same two values again, exposed to the browser build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# https://aistudio.google.com/apikey — billing must be enabled.
GOOGLE_GENERATIVE_AI_API_KEY=

# Any long random string. Signs OAuth state.
YOUTUBE_OAUTH_STATE_SECRET=

# ── Optional: publishing platforms ──────────────────────────────────────────
# Leave blank until you've registered each developer app under your own
# account and passed that platform's review.

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_API_KEY=

META_APP_ID=
META_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=